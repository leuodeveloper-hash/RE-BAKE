rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // 레시피 사진: 읽기=공개(앱/위젯에서 표시), 쓰기=로그인 유저
    // 한 장 1MB까지 — 앱이 올리기 전에 줄인다(utils/imageUpload). 지우기는 크기와 무관
    match /recipe_images/{imageId} {
      allow read: if true;
      allow create, update: if request.auth != null && request.resource.size < 1 * 1024 * 1024 && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null;
    }

    // 회고 사진: 본인 폴더에만 쓰기, 읽기는 공개(회고·공유 카드에 보인다)
    match /review_photos/{uid}/{file} {
      allow read: if true;
      allow create, update: if request.auth != null && request.auth.uid == uid && request.resource.size < 1 * 1024 * 1024 && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // 이미지 인식 기록 사진: 로그인 사용자가 올리고, 보기는 다운로드 주소(토큰)로만.
    // 이 경로가 막혀 있어 인식 기록에 사진이 하나도 안 남았다
    match /ocr_logs/{file} {
      allow create: if request.auth != null && request.resource.size < 15 * 1024 * 1024;
      allow read, update, delete: if false;
    }

    // 그 외 경로는 차단 (필요한 경로만 위에 명시적 허용)
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
