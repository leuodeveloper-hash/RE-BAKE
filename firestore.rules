rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 어드민 판별 (클라이언트 AuthContext와 동일 기준):
    // admin/{uid} 문서 존재 또는 어드민 이메일 허용목록.
    function isAdmin() {
      return request.auth != null && (
        exists(/databases/$(database)/documents/admin/$(request.auth.uid)) ||
        request.auth.token.email in ['leuo.developer@gmail.com']
      );
    }

    // users: 본인 문서만 읽기/쓰기
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // signupLimits: 일일 가입 한도 카운터(signupLimits/{YYYY-MM-DD}).
    // read는 가입 '전'(미인증) 단계에서 한도를 확인해야 하므로 공개.
    // write는 가입 직후 인증된 사용자만(카운트 증가). 규칙이 없으면 기본 거부라
    // checkSignupLimit()가 permission-denied로 throw돼 가입 자체가 실패했음.
    match /signupLimits/{day} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // admin: 로그인 사용자 본인 문서만 읽기 (쓰기는 Firebase Console에서만)
    match /admin/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // user_recipes: 본인 레시피만 읽기/쓰기
    match /user_recipes/{uid}/recipes/{recipeId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // explore_recipes: 숨김(hidden==true)은 어드민만. 그 외 공개.
    // ⚠️ 목록(list) 쿼리 규칙: 비어드민 클라이언트는 반드시 where('hidden','==',false)로 제약해야 함
    //    (제약 없는 컬렉션 쿼리는 숨김 문서를 반환할 수 있어 전체 거부됨).
    match /explore_recipes/{recipeId} {
      allow read: if isAdmin() || resource.data.hidden == false;
      allow write: if isAdmin();
    }

    // explore_meta: 누구나 읽기, 쓰기는 어드민만
    match /explore_meta/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // explore_cookbooks: 숨김(hidden==true)은 어드민만. 그 외 공개. (list는 where hidden==false 필요)
    match /explore_cookbooks/{docId} {
      allow read: if isAdmin() || resource.data.hidden == false;
      allow write: if isAdmin();
    }

    // exam_schedules: 누구나 읽기(공개 시험일정), 쓰기는 어드민만
    match /exam_schedules/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

  }
}
