{
  "expo": {
    "newArchEnabled": false,
    "name": "Bakecycle",
    "slug": "rebake",
    "version": "0.8.5",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#FCEEE3"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bakecycle.app",
      "buildNumber": "4",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true,
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FCEEE3"
      },
      "package": "com.bakecycle.app",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "scheme": "bakecycle",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/27699c8b-30e7-4169-baa1-f39120d4221e"
    },
    "plugins": [
      "expo-dev-client",
      "expo-updates",
      "expo-web-browser",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/IBMPlexSans_400Regular.ttf",
            "./assets/fonts/IBMPlexSans_500Medium.ttf",
            "./assets/fonts/IBMPlexSans_600SemiBold.ttf",
            "./assets/fonts/IBMPlexSans_700Bold.ttf"
          ]
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.420587944388-03rb31splmt5jrme91ntt4k5a1cn7dk7"
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3940256099942544~3347511713",
          "iosAppId": "ca-app-pub-3940256099942544~3347511713"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "27699c8b-30e7-4169-baa1-f39120d4221e"
      }
    },
    "owner": "leuokim"
  }
}
