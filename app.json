{
  "expo": {
    "newArchEnabled": true,
    "name": "Bakle",
    "slug": "bakle",
    "locales": {
      "ko": "./languages/ko.json"
    },
    "version": "1.0.21",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#F8F5ED"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bakle.app",
      "googleServicesFile": "./GoogleService-Info.plist",
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.bakle.app"
        ]
      },
      "infoPlist": {
        "CFBundleDisplayName": "Bakle",
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "레시피 사진을 촬영하고 텍스트를 자동 인식하기 위해 카메라를 사용합니다.",
        "NSPhotoLibraryUsageDescription": "레시피 사진을 고를 때 앱 안에서 사진첩을 바로 보여주고, 마지막으로 연 앨범을 기억해 매번 앨범을 다시 찾지 않도록 사진 접근이 필요해요.",
        "NSMicrophoneUsageDescription": "음성 입력을 위해 마이크를 사용합니다.",
        "NSSpeechRecognitionUsageDescription": "음성 입력을 텍스트로 변환하기 위해 음성 인식을 사용합니다.",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true,
          "NSAllowsLocalNetworking": true
        },
        "NSPhotoLibraryAddUsageDescription": "레시피 사진을 찍으면 사진첩에도 함께 저장하고, 레시피 공유 카드를 사진첩에 저장해요.",
        "LSApplicationQueriesSchemes": [
          "instagram",
          "instagram-stories"
        ]
      },
      "usesAppleSignIn": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FCEEE3"
      },
      "package": "com.bakle.app",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "scheme": "bakle",
    "plugins": [
      "expo-dev-client",
      "@react-native-firebase/app",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "color": "#FCEEE3",
          "icon": "./assets/notification-icon.png"
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "음성 입력을 위해 마이크를 사용합니다.",
          "speechRecognitionPermission": "음성 입력을 텍스트로 변환하기 위해 음성 인식을 사용합니다."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-blank.png",
          "imageWidth": 300,
          "resizeMode": "contain",
          "backgroundColor": "#F8F5ED",
          "dark": {
            "image": "./assets/images/splash-blank.png",
            "backgroundColor": "#0E0E0D"
          }
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Pretendard-Regular.otf",
            "./assets/fonts/Pretendard-Medium.otf",
            "./assets/fonts/Pretendard-SemiBold.otf",
            "./assets/fonts/Pretendard-Bold.otf"
          ]
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.420587944388-q35p6cgif79uebn275run2nftrq926st"
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-9641282889322635~2260451659",
          "iosAppId": "ca-app-pub-9641282889322635~2260451659"
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "15.5",
            "useFrameworks": "static",
            "forceStaticLinking": [
              "RNFBApp",
              "RNFBAnalytics"
            ]
          }
        }
      ],
      "expo-localization",
      [
        "@bacons/apple-targets",
        {
          "appleTeamId": "LAQFXSQ5VJ"
        }
      ],
      [
        "react-native-android-widget",
        {
          "fonts": [
            "./targets/widget/fonts/Pretendard-Regular.otf",
            "./targets/widget/fonts/Pretendard-Medium.otf",
            "./targets/widget/fonts/Pretendard-Bold.otf"
          ],
          "widgets": [
            {
              "name": "BakleWidget",
              "label": "오늘의 레시피",
              "description": "매일 새로운 오늘의 레시피와 시험 D-day를 보여드려요.",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "maxResizeWidth": "420dp",
              "maxResizeHeight": "420dp",
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ]
    ],
    "owner": "leuokim"
  }
}
