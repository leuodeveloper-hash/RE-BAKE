{
  "expo": {
    "newArchEnabled": true,
    "name": "베이클",
    "slug": "rebake",
    "locales": {
      "ko": "./languages/ko.json"
    },
    "version": "0.8.8",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#F8F5ED"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bakle.app",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "레시피 사진을 촬영하고 텍스트를 자동 인식하기 위해 카메라를 사용합니다.",
        "NSPhotoLibraryUsageDescription": "레시피 이미지를 추가하기 위해 사진 라이브러리에 접근합니다.",
        "NSMicrophoneUsageDescription": "음성 입력을 위해 마이크를 사용합니다.",
        "NSSpeechRecognitionUsageDescription": "음성 입력을 텍스트로 변환하기 위해 음성 인식을 사용합니다.",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true,
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FCEEE3"
      },
      "package": "com.bakle.app",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "scheme": "bakle",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/27699c8b-30e7-4169-baa1-f39120d4221e"
    },
    "plugins": [
      "expo-dev-client",
      "expo-updates",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "color": "#FCEEE3"
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "음성 입력을 위해 마이크를 사용합니다.",
          "speechRecognitionPermission": "음성 입력을 텍스트로 변환하기 위해 음성 인식을 사용합니다."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F8F5ED"
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Pretendard-Regular.otf",
            "./assets/fonts/Pretendard-Medium.otf",
            "./assets/fonts/Pretendard-SemiBold.otf",
            "./assets/fonts/Pretendard-Bold.otf"
          ]
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.420587944388-q35p6cgif79uebn275run2nftrq926st"
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-9641282889322635~2260451659",
          "iosAppId": "ca-app-pub-9641282889322635~2260451659"
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "15.5"
          }
        }
      ],
      "expo-localization"
    ],
    "extra": {
      "eas": {
        "projectId": "27699c8b-30e7-4169-baa1-f39120d4221e"
      }
    },
    "owner": "leuokim"
  }
}
